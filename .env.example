# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit the values before starting the app.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Credentials for the bundled PostgreSQL container. Change POSTGRES_PASSWORD
# to something random before exposing this app to a network.
POSTGRES_USER=pain
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=paintracker

# Connection string used by the app and by Prisma migrations.
# Inside Docker Compose the host is the service name (`db`) and the port is
# 15432, which is the port PostgreSQL listens on inside its container.
DATABASE_URL=postgresql://pain:change-me-please@db:15432/paintracker?schema=public

# When running the app on your host machine against the Compose database, use
# `localhost` and DB_PORT - the host port, which is a different number:
# DATABASE_URL=postgresql://pain:change-me-please@localhost:15432/paintracker?schema=public

# --- Authentication ---------------------------------------------------------
# Secret used to sign session cookies. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# How long a session stays valid, in days.
SESSION_DAYS=30

# Set to "true" to let anyone reach the /register page. The FIRST account can
# always be created regardless of this setting, so the default of "false" is
# safe for a personal, network-exposed instance.
ALLOW_REGISTRATION=false

# --- App --------------------------------------------------------------------
# Your timezone. The app has no per-user timezone setting: this one value is
# the clock it reads times as when you type them, and the clock it shows them
# on. Get it wrong and every duration and "when did it start" will be off.
#
# Use an IANA zone name, NOT an abbreviation. "America/Los_Angeles" follows
# daylight saving on its own; a literal "PST" would pin you to UTC-8 all year
# and be an hour out from March to November.
#
# Other examples: America/New_York, America/Denver, America/Chicago,
# Europe/London, Europe/Berlin, Asia/Tokyo, Australia/Sydney, UTC
TZ=America/Los_Angeles

# --- Ports ------------------------------------------------------------------
# These two are the ONLY port settings.
#
#   APP_PORT   the address you open in a browser -> http://localhost:APP_PORT
#   DB_PORT    the port host-side tools connect to (psql, npm run create-user)
#
# APP_BIND below decides which interface APP_PORT is published on; DB_PORT is
# always loopback.
#
# Change either if something on the machine already claims it; Docker reports
# the clash as "port is already allocated" when the stack starts.
APP_PORT=13000
DB_PORT=15432

# Which of the host's network interfaces the app is published on.
#
#   127.0.0.1   (default) the machine itself only. Anything coming from the
#               network is REFUSED - on a VM, an LXC or a headless server this
#               is indistinguishable from a broken deploy: the container is
#               healthy, `curl localhost:APP_PORT` works when you ssh in, and
#               a browser on your laptop says "connection refused".
#   0.0.0.0     every interface, so other machines on the network can reach it
#               at http://<server-ip>:APP_PORT
#
# 0.0.0.0 serves the app over plain HTTP: the login password, the session
# cookie and every pain note cross the network unencrypted, and cookies cannot
# be marked Secure. Acceptable on a network you trust while you get set up; for
# anything longer-lived put a reverse proxy with HTTPS in front and leave this
# at 127.0.0.1. See README > Reaching it from other machines.
APP_BIND=127.0.0.1

# Inside the containers the app listens on 13000 and PostgreSQL on 15432, no
# matter what you set above. Those are fixed, and they are not settings -
# `docker compose up` publishes APP_PORT:13000 and DB_PORT:15432, so the number
# you see in `docker compose logs` ("Ready on port 13000") is the inside one and
# does not change when you move APP_PORT. The app also reaches the database over
# Compose's private network at `db:15432`, so the DATABASE_URL above never
# changes with DB_PORT; only a host-side DATABASE_URL tracks DB_PORT.
#
# Every port in the stack is above 10000 so that a 5432 or 3000 in an error
# message can only be coming from something outside this project. Note that
# this is cosmetic: a container's own ports live in its own network namespace
# and can never collide with anything on the host. Only APP_PORT and DB_PORT,
# which are host ports, can ever produce "port is already allocated".
